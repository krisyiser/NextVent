<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NextVent.ViewModels"
             xmlns:dto="using:NextVent.Data.Dtos"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="NextVent.Views.History.HistorySalesTableView"
             x:DataType="vm:HistoryViewModel">

    <!-- ═══ MAIN TRANSACTIONS TABLE ═══ -->
    <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}" Padding="16">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="Registro Chronológico de Ventas Procesadas" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sales}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dto:SaleDto">
                            <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <!-- Main Header Row -->
                                    <Grid ColumnDefinitions="140,240,*,120,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Id, StringFormat='Folio: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding LocalDateDisplay}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding PaymentMethod, StringFormat='Pago: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Background="{Binding PaymentStatusColor}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding PaymentStatusDisplay}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                                <TextBlock Text="{Binding EstadoFiscal, StringFormat='Factura: {0}'}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Items.Count, StringFormat='{}{0} Productos'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0" />

                                        <TextBlock Grid.Column="3" Text="{Binding Total, StringFormat='${0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0" />

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Command="{Binding $parent[UserControl].((vm:HistoryViewModel)DataContext).OpenReturnDialogCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,6" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource AccentWarningBrush}" BorderThickness="1" ToolTip.Tip="Devolver producto individual del ticket">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <mi:MaterialIcon Kind="KeyboardReturn" Width="16" Height="16" Foreground="{DynamicResource AccentWarningBrush}" />
                                                    <TextBlock Text="DEVOLUCIÓN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentWarningBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <Button Command="{Binding $parent[UserControl].((vm:HistoryViewModel)DataContext).RePrintTicketCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="12,6" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <mi:MaterialIcon Kind="PrinterOutline" Width="16" Height="16" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                                    <TextBlock Text="REIMPRIMIR TICKET" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <Button Command="{Binding $parent[UserControl].((vm:HistoryViewModel)DataContext).CancelSaleCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="8,6" CornerRadius="{DynamicResource AppCornerRadius}" Background="Transparent" BorderBrush="{DynamicResource AccentDangerBrush}" BorderThickness="1" ToolTip.Tip="Cancelar Venta Completa (Requiere Supervisor)">
                                                <mi:MaterialIcon Kind="Cancel" Width="16" Height="16" Foreground="{DynamicResource AccentDangerBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4" />

                                    <!-- Items Detail Row -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" ItemWidth="280" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="dto:SaleItemSnapshotDto">
                                                <Border Padding="6,4" Margin="4" CornerRadius="4" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="• {0} (x{1:N1} {2})">
                                                                    <Binding Path="Name"/>
                                                                    <Binding Path="Quantity"/>
                                                                    <Binding Path="Unit"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="8,0,0,0">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="${0:N2}">
                                                                    <Binding Path="TotalPrice"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>

