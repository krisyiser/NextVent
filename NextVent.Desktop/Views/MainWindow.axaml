<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NextVent.ViewModels"
        xmlns:vmDialogs="using:NextVent.ViewModels.Dialogs"
        xmlns:v="using:NextVent.Views"
        xmlns:vDialogs="using:NextVent.Views.Dialogs"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="NextVent.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NextVent POS — Sistema Nactivo Enterprise"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.DataTemplates>
        <!-- Module View Templates -->
        <DataTemplate DataType="vm:PosViewModel">
            <v:PosView />
        </DataTemplate>
        <DataTemplate DataType="vm:InventoryViewModel">
            <v:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="vm:CustomersViewModel">
            <v:CustomersView />
        </DataTemplate>
        <DataTemplate DataType="vm:SuppliersViewModel">
            <v:SuppliersView />
        </DataTemplate>
        <DataTemplate DataType="vm:ExpensesViewModel">
            <v:ExpensesView />
        </DataTemplate>
        <DataTemplate DataType="vm:HistoryViewModel">
            <v:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="vm:PromotionsViewModel">
            <v:PromotionsView />
        </DataTemplate>
        <DataTemplate DataType="vm:FiscalViewModel">
            <v:FiscalView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <v:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:LoginViewModel">
            <v:LoginView />
        </DataTemplate>
        <DataTemplate DataType="vm:FirstTimeSetupViewModel">
            <v:FirstTimeSetupView />
        </DataTemplate>

        <!-- Modal Dialog Templates -->
        <DataTemplate DataType="vmDialogs:CheckoutDialogViewModel">
            <vDialogs:CheckoutDialog />
        </DataTemplate>
        <DataTemplate DataType="vmDialogs:ProductDialogViewModel">
            <vDialogs:ProductDialog />
        </DataTemplate>
        <DataTemplate DataType="vmDialogs:CustomerDialogViewModel">
            <vDialogs:CustomerDialog />
        </DataTemplate>
        <DataTemplate DataType="vmDialogs:PromotionDialogViewModel">
            <vDialogs:PromotionDialog />
        </DataTemplate>
        <DataTemplate DataType="vmDialogs:PaymentDialogViewModel">
            <vDialogs:PaymentDialog />
        </DataTemplate>
        <DataTemplate DataType="vmDialogs:CashupDialogViewModel">
            <vDialogs:CashupDialog />
        </DataTemplate>
        <DataTemplate DataType="vmDialogs:CustomerStatementDialogViewModel">
            <vDialogs:CustomerStatementDialog />
        </DataTemplate>
        <DataTemplate DataType="vmDialogs:ItemKitDialogViewModel">
            <vDialogs:ItemKitDialog />
        </DataTemplate>
        <DataTemplate DataType="vmDialogs:ReturnDialogViewModel">
            <vDialogs:ReturnDialog />
        </DataTemplate>
        <DataTemplate DataType="vmDialogs:ShiftNotesDialogViewModel">
            <vDialogs:ShiftNotesDialog />
        </DataTemplate>
        <DataTemplate DataType="vmDialogs:SwitchUserPinDialogViewModel">
            <vDialogs:SwitchUserPinDialog />
        </DataTemplate>
        <DataTemplate DataType="vmDialogs:LockScreenDialogViewModel">
            <vDialogs:LockScreenDialog />
        </DataTemplate>
        <DataTemplate DataType="vmDialogs:SupervisorPinDialogViewModel">
            <vDialogs:SupervisorPinDialog />
        </DataTemplate>
        <DataTemplate DataType="vmDialogs:ConfirmDialogViewModel">
            <vDialogs:ConfirmDialog />
        </DataTemplate>
        <DataTemplate DataType="vmDialogs:ConfigureMinStockDialogViewModel">
            <vDialogs:ConfigureMinStockDialog />
        </DataTemplate>
        <DataTemplate DataType="vmDialogs:OpenShiftDialogViewModel">
            <vDialogs:OpenShiftDialog />
        </DataTemplate>
    </Window.DataTemplates>

    <Panel>
        <DockPanel LastChildFill="True" Margin="0,30,0,0"> <!-- Margin for extended TitleBar -->

            <!-- ═══ SIDEBAR NAVIGATION ═══ -->
            <Border DockPanel.Dock="{Binding SidebarDockPosition}"
                    Width="{Binding SidebarWidth}"
                    Height="{Binding SidebarHeight}"
                    Background="{DynamicResource SidebarBgBrush}"
                    Padding="0,0,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Orientation="{Binding SidebarOrientation}" Spacing="10" Margin="8,8,8,8"
                                HorizontalAlignment="Center" VerticalAlignment="Center">

                        <!-- Dynamic Logo Badge -->
                        <Border Width="{DynamicResource AppLogoHeight}" Height="{DynamicResource AppLogoHeight}" CornerRadius="{DynamicResource AppCornerRadius}"
                                Background="{DynamicResource AccentPrimaryBrush}" Margin="4"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="NV" FontSize="16" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Nav: POS (F2) -->
                        <Button Classes="nav-item"
                                Command="{Binding NavigateToCommand}" CommandParameter="pos"
                                ToolTip.Tip="Punto de Venta">
                            <StackPanel Spacing="2">
                                <mi:MaterialIcon Kind="PointOfSale" Width="22" Height="22" HorizontalAlignment="Center" />
                                <TextBlock Text="Ventas" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Nav: Inventory (F3) -->
                        <Button Classes="nav-item"
                                Command="{Binding NavigateToCommand}" CommandParameter="inventory"
                                ToolTip.Tip="Inventario">
                            <StackPanel Spacing="2">
                                <mi:MaterialIcon Kind="PackageVariantClosed" Width="22" Height="22" HorizontalAlignment="Center" />
                                <TextBlock Text="Inventario" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Nav: Customers (F4) -->
                        <Button Classes="nav-item"
                                Command="{Binding NavigateToCommand}" CommandParameter="customers"
                                ToolTip.Tip="Clientes y Crédito">
                            <StackPanel Spacing="2">
                                <mi:MaterialIcon Kind="AccountGroup" Width="22" Height="22" HorizontalAlignment="Center" />
                                <TextBlock Text="Clientes" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Nav: Suppliers (F5) -->
                        <Button Classes="nav-item"
                                Command="{Binding NavigateToCommand}" CommandParameter="suppliers"
                                ToolTip.Tip="Proveedores y Compras">
                            <StackPanel Spacing="2">
                                <mi:MaterialIcon Kind="TruckDelivery" Width="22" Height="22" HorizontalAlignment="Center" />
                                <TextBlock Text="Proveedores" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Nav: Expenses (F6) -->
                        <Button Classes="nav-item"
                                Command="{Binding NavigateToCommand}" CommandParameter="expenses"
                                ToolTip.Tip="Gastos y Utilidad Neta">
                            <StackPanel Spacing="2">
                                <mi:MaterialIcon Kind="CashMinus" Width="22" Height="22" HorizontalAlignment="Center" />
                                <TextBlock Text="Gastos" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Nav: History (F7) -->
                        <Button Classes="nav-item"
                                Command="{Binding NavigateToCommand}" CommandParameter="history"
                                ToolTip.Tip="Historial de Ventas">
                            <StackPanel Spacing="2">
                                <mi:MaterialIcon Kind="History" Width="22" Height="22" HorizontalAlignment="Center" />
                                <TextBlock Text="Historial" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Nav: Promotions (F8) -->
                        <Button Classes="nav-item"
                                Command="{Binding NavigateToCommand}" CommandParameter="promotions"
                                ToolTip.Tip="Promociones">
                            <StackPanel Spacing="2">
                                <mi:MaterialIcon Kind="TagMultiple" Width="22" Height="22" HorizontalAlignment="Center" />
                                <TextBlock Text="Promos" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Nav: Fiscal (F9) -->
                        <Button Classes="nav-item"
                                Command="{Binding NavigateToCommand}" CommandParameter="fiscal"
                                ToolTip.Tip="Facturación SAT">
                            <StackPanel Spacing="2">
                                <mi:MaterialIcon Kind="ReceiptTextOutline" Width="22" Height="22" HorizontalAlignment="Center" />
                                <TextBlock Text="Factura" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Nav: Settings (F10) -->
                        <Button Classes="nav-item"
                                Command="{Binding NavigateToCommand}" CommandParameter="settings"
                                ToolTip.Tip="Configuración">
                            <StackPanel Spacing="2">
                                <mi:MaterialIcon Kind="CogOutline" Width="22" Height="22" HorizontalAlignment="Center" />
                                <TextBlock Text="Ajustes" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══ MAIN CONTENT AREA ═══ -->
            <DockPanel LastChildFill="True">
                <!-- Active Module Content -->
                <ContentControl Content="{Binding ActiveViewModel}" IsEnabled="{Binding !IsLocked}" />
            </DockPanel>
        </DockPanel>

        <!-- ═══ MODAL DIALOG OVERLAY ═══ -->
        <Grid IsVisible="{Binding IsDialogOverlayOpen}" Background="#80000000">
            <ContentControl Content="{Binding ActiveDialogViewModel}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- OVERLAY LOCK SCREEN (Prevents Modal Collision) -->
        <Grid ZIndex="9999" IsVisible="{Binding IsLocked}" Background="#E60F172A">
            <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}" Padding="30" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="LockAlert" Width="26" Height="26" Foreground="{DynamicResource AccentDangerBrush}" />
                        <TextBlock Text="TERMINAL BLOQUEADA" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    
                    <TextBlock Text="Ingrese su PIN para desbloquear la sesión" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                    
                    <TextBox Text="{Binding UnlockPin, Mode=TwoWay}" PasswordChar="•" Width="220" Padding="12" FontSize="16" HorizontalAlignment="Center" HorizontalContentAlignment="Center" />
                    
                    <TextBlock Text="{Binding UnlockErrorMessage}" Foreground="{DynamicResource AccentDangerBrush}" FontSize="12" HorizontalAlignment="Center" IsVisible="{Binding UnlockErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    
                    <Button Command="{Binding UnlockTerminalCommand}" Classes="danger-action" Width="220" Height="40" HorizontalAlignment="Center" CornerRadius="{DynamicResource AppCornerRadius}">
                        <TextBlock Text="DESBLOQUEAR" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Panel>
</Window>
