<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NextVent.ViewModels"
             xmlns:pos="using:NextVent.Views.Pos"
             x:Class="NextVent.Views.PosView"
             x:DataType="vm:PosViewModel">

    <!-- ⌨️ ATAJOS DE TECLADO GLOBALES PARA EL POS -->
    <UserControl.KeyBindings>
        <KeyBinding Gesture="F1" Command="{Binding SwitchCashierCommand}" />
        <KeyBinding Gesture="Win+L" Command="{Binding LockTerminalCommand}" />
        <KeyBinding Gesture="F10" Command="{Binding PayCashCommand}" />
        <KeyBinding Gesture="F11" Command="{Binding PayCardCommand}" />
    </UserControl.KeyBindings>

    <Grid RowDefinitions="Auto,*" Margin="16">

        <!-- ═══ 1. TOP FUNCTION BANNER BAR ═══ -->
        <pos:PosHeaderBarView Grid.Row="0" Margin="0,0,0,16" />

        <!-- ═══ 2. MAIN POS WORKSPACE WITH DYNAMIC CART POSITION (LEFT / RIGHT) ═══ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <pos:PosProductCatalogView Grid.Column="{Binding ProductsGridColumn}" Margin="{Binding ProductsMargin}" />
            <pos:PosCartTicketView Grid.Column="{Binding CartGridColumn}" />
        </Grid>

    </Grid>
</UserControl>