<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NextVent.ViewModels"
             x:Class="NextVent.Views.Settings.AtajosSettingsView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="20" Margin="10">
        <TextBlock Text="Configuración de Atajos de Teclado (Hotkeys)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="Personalice los atajos globales para operaciones rápidas del Punto de Venta" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />

        <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}" Padding="20">
            <StackPanel Spacing="16">
                <!-- Shortcut: Cobrar Ticket -->
                <Grid ColumnDefinitions="*,200">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Cobrar Ticket (Checkout)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Acceso rápido para abrir el diálogo de cobro y pago" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding ShortcutCharge, Mode=TwoWay}" Padding="10,8" Watermark="ej. F12 o Enter" VerticalAlignment="Center" />
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderBrush}" />

                <!-- Shortcut: Enfocar Búsqueda -->
                <Grid ColumnDefinitions="*,200">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Enfocar Barra de Búsqueda" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Coloca el cursor en el buscador y selecciona el texto existente" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding ShortcutSearch, Mode=TwoWay}" Padding="10,8" Watermark="ej. F3 o Ctrl+F" VerticalAlignment="Center" />
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderBrush}" />

                <!-- Shortcut: Pausar Carrito -->
                <Grid ColumnDefinitions="*,200">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Pausar / Aparcar Carrito" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Guarda temporalmente la venta actual para atender a otro cliente" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding ShortcutPause, Mode=TwoWay}" Padding="10,8" Watermark="ej. F7" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Save Button -->
        <Button Command="{Binding SaveAllSettingsCommand}" Classes="primary-action" Height="40" Width="180" HorizontalAlignment="Right">
            <TextBlock Text="Guardar Atajos" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>
    </StackPanel>
</UserControl>
