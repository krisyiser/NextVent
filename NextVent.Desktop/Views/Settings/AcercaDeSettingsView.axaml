<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NextVent.ViewModels"
             x:Class="NextVent.Views.Settings.AcercaDeSettingsView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="15">
        <TextBlock Text="Acerca de TICKETFY! Enterprise" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />

        <Border Padding="20" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel Spacing="5" Margin="0,0,0,10">
                <TextBlock Text="{Binding FullAppVersionTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                <TextBlock Text="Sistema de Gestión de Punto de Venta" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="© 2026 Valcore. Todos los derechos reservados." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

