<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NextVent.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="NextVent.Views.Settings.InterfazSettingsView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="16">
        <!-- Sub-tab Navigation Bar (6 Sub-tabs) -->
        <Border Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="4">
            <UniformGrid Columns="6">
                <Button Command="{Binding SelectSubTabCommand}" CommandParameter="tema" Padding="6,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgSecondaryBrush}">
                    <TextBlock Text="Tema" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                </Button>
                <Button Command="{Binding SelectSubTabCommand}" CommandParameter="colores" Padding="6,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgSecondaryBrush}">
                    <TextBlock Text="Colores" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                </Button>
                <Button Command="{Binding SelectSubTabCommand}" CommandParameter="fuentes" Padding="6,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgSecondaryBrush}">
                    <TextBlock Text="Tipografía" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                </Button>
                <Button Command="{Binding SelectSubTabCommand}" CommandParameter="disposicion" Padding="6,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgSecondaryBrush}">
                    <TextBlock Text="Disposición" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                </Button>
                <Button Command="{Binding SelectSubTabCommand}" CommandParameter="componentes" Padding="6,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgSecondaryBrush}">
                    <TextBlock Text="Botones" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                </Button>
                <Button Command="{Binding SelectSubTabCommand}" CommandParameter="animaciones" Padding="6,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgSecondaryBrush}">
                    <TextBlock Text="Animaciones" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                </Button>
            </UniformGrid>
        </Border>

        <!-- 2-COLUMN LAYOUT: CONTROLS STUDIO (LEFT) vs MANDATORY LIVE PREVIEW BOX (RIGHT) -->
        <Grid ColumnDefinitions="*,320">

            <!-- ─── LEFT COLUMN: SUB-TAB GRANULAR CONTROLS STUDIO ─── -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0" Spacing="16">

                <!-- 2.1 SUB-TAB TEMA -->
                <StackPanel IsVisible="{Binding IsSubTema}" Spacing="14">
                    <TextBlock Text="Modos &amp; Textura de Fondo (7 Presets)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    
                    <UniformGrid Columns="2">
                        <Button Command="{Binding SelectThemeCommand}" CommandParameter="Modo Claro" Margin="0,0,4,6" Padding="10" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgPrimaryBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="2">
                            <TextBlock Text="Modo Claro" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        </Button>
                        <Button Command="{Binding SelectThemeCommand}" CommandParameter="Modo Oscuro" Margin="4,0,0,6" Padding="10" CornerRadius="{DynamicResource AppCornerRadius}" Background="#0F172A" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="Modo Oscuro" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                        </Button>
                        <Button Command="{Binding SelectThemeCommand}" CommandParameter="Alto Contraste" Margin="0,0,4,6" Padding="10" CornerRadius="{DynamicResource AppCornerRadius}" Background="#000000" BorderBrush="#FFFFFF" BorderThickness="2">
                            <TextBlock Text="Alto Contraste" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentWarningBrush}" HorizontalAlignment="Center" />
                        </Button>
                        <Button Command="{Binding SelectThemeCommand}" CommandParameter="Cyberpunk Dark" Margin="4,0,0,6" Padding="10" CornerRadius="{DynamicResource AppCornerRadius}" Background="#09090B" BorderBrush="#8B5CF6" BorderThickness="2">
                            <TextBlock Text="Cyberpunk Dark" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" />
                        </Button>
                        <Button Command="{Binding SelectThemeCommand}" CommandParameter="Emerald Glass" Margin="0,0,4,0" Padding="10" CornerRadius="{DynamicResource AppCornerRadius}" Background="#022C22" BorderBrush="#34D399" BorderThickness="2">
                            <TextBlock Text="Emerald Glass" FontSize="12" FontWeight="Bold" Foreground="#A7F3D0" HorizontalAlignment="Center" />
                        </Button>
                        <Button Command="{Binding SelectThemeCommand}" CommandParameter="Nordic Slate" Margin="4,0,0,0" Padding="10" CornerRadius="{DynamicResource AppCornerRadius}" Background="#1E293B" BorderBrush="#94A3B8" BorderThickness="1">
                            <TextBlock Text="Nordic Slate" FontSize="12" FontWeight="Bold" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                        </Button>
                    </UniformGrid>

                    <!-- Glassmorphism Sliders with Numeric Badges -->
                    <StackPanel Spacing="10" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Desenfoque Glassmorphism (Blur)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border Grid.Column="1" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2">
                                <TextBlock Text="{Binding GlassmorphismBlur, StringFormat='{}{0:F0} px'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            </Border>
                        </Grid>
                        <Slider Minimum="0" Maximum="24" Value="{Binding GlassmorphismBlur, Mode=TwoWay}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Opacidad de Tarjetas Contenedoras" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border Grid.Column="1" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2">
                                <TextBlock Text="{Binding GlassmorphismOpacity, StringFormat='{}{0:F0} %'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            </Border>
                        </Grid>
                        <Slider Minimum="20" Maximum="100" Value="{Binding GlassmorphismOpacity, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>

                <!-- 2.2 SUB-TAB COLORES & BRANDING -->
                <StackPanel IsVisible="{Binding IsSubColores}" Spacing="16">
                    <TextBlock Text="Paletas de Colores &amp; Identidad Visual (Sin códigos Hexadecimales)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    
                    <!-- Logo Scale Slider Card -->
                    <Border Padding="14,12" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Escala de Logo Corporativo en Barra" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Border Grid.Column="1" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2">
                                    <TextBlock Text="{Binding EscalaLogoTopbar, StringFormat='{}{0:F0} px'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                </Border>
                            </Grid>
                            <Slider Minimum="20" Maximum="56" Value="{Binding EscalaLogoTopbar, Mode=TwoWay}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 1. COLOR BOTÓN COBRAR (ÉXITO) -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Color Botón Cobrar (Éxito en Ventas)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ItemsControl ItemsSource="{Binding SuccessColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ColorPaletteItem">
                                    <Button Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectSuccessColorCommand}"
                                            CommandParameter="{Binding HexColor}"
                                            Margin="2" Padding="6" Height="36" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgSecondaryBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <Border Width="14" Height="14" CornerRadius="7" Background="{Binding HexColor}" />
                                            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 2. COLOR ANULAR / CANCELAR -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Color Botón Anular / Cancelar (Alertas)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ItemsControl ItemsSource="{Binding DangerColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ColorPaletteItem">
                                    <Button Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectDangerColorCommand}"
                                            CommandParameter="{Binding HexColor}"
                                            Margin="2" Padding="6" Height="36" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgSecondaryBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <Border Width="14" Height="14" CornerRadius="7" Background="{Binding HexColor}" />
                                            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 3. COLOR ACENTO PRINCIPAL -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Color Acento Principal (Foco del Sistema)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ItemsControl ItemsSource="{Binding AccentColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ColorPaletteItem">
                                    <Button Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectAccentCommand}"
                                            CommandParameter="{Binding HexColor}"
                                            Margin="2" Padding="6" Height="36" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgSecondaryBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <Border Width="14" Height="14" CornerRadius="7" Background="{Binding HexColor}" />
                                            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 4. COLOR DE BARRA LATERAL -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Color de Fondo de Barra Lateral de Navegación" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ItemsControl ItemsSource="{Binding SidebarColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ColorPaletteItem">
                                    <Button Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectSidebarColorCommand}"
                                            CommandParameter="{Binding HexColor}"
                                            Margin="2" Padding="6" Height="36" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgSecondaryBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <Border Width="14" Height="14" CornerRadius="7" Background="{Binding HexColor}" />
                                            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- 2.3 SUB-TAB TIPOGRAFÍA -->
                <StackPanel IsVisible="{Binding IsSubFuentes}" Spacing="14">
                    <TextBlock Text="Tipografía Inspector &amp; Escalamiento" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="Familia Tipográfica" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding AvailableFontOptions}" SelectedItem="{Binding AppFont, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8,6" />
                    </StackPanel>

                    <StackPanel Spacing="10" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Tamaño Base de Interfaz" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border Grid.Column="1" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2">
                                <TextBlock Text="{Binding TamanoFuenteBasePx, StringFormat='{}{0:F0} px'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            </Border>
                        </Grid>
                        <Slider Minimum="12" Maximum="18" Value="{Binding TamanoFuenteBasePx, Mode=TwoWay}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Tamaño de Precios POS" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border Grid.Column="1" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2">
                                <TextBlock Text="{Binding TamanoPreciosPosPx, StringFormat='{}{0:F0} px'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            </Border>
                        </Grid>
                        <Slider Minimum="18" Maximum="36" Value="{Binding TamanoPreciosPosPx, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>

                <!-- 2.4 SUB-TAB DISPOSICIÓN & GRID -->
                <StackPanel IsVisible="{Binding IsSubDisposicion}" Spacing="14">
                    <TextBlock Text="Disposición de Espacio POS &amp; Densidad" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,8" Spacing="4">
                            <TextBlock Text="Posición del Carrito" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding PosicionCarritoOptions}" SelectedItem="{Binding PosicionCarrito, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8,6" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,8" Spacing="4">
                            <TextBlock Text="Posición de Barra Lateral" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding PosicionSidebarOptions}" SelectedItem="{Binding SidebarPosition, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8,6" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,8" Spacing="4">
                            <TextBlock Text="Columnas de Matriz" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding ProductGridColumnsOptions}" SelectedItem="{Binding SelectedProductGridColumns, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8,6" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,8" Spacing="4">
                            <TextBlock Text="Densidad Espacial" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding ModoDensidadOptions}" SelectedItem="{Binding ModoDensidadEspacial, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8,6" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Ancho del Carrito POS" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Border Grid.Column="1" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2">
                            <TextBlock Text="{Binding AnchoCarritoPx, StringFormat='{}{0:F0} px'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                        </Border>
                    </Grid>
                    <Slider Minimum="300" Maximum="550" Value="{Binding AnchoCarritoPx, Mode=TwoWay}" />
                </StackPanel>

                <!-- 2.5 SUB-TAB BOTONES & COMPONENTES -->
                <StackPanel IsVisible="{Binding IsSubComponentes}" Spacing="14">
                    <TextBlock Text="Geometría, Sombras &amp; Switches de Tarjeta" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Radio de Bordes (Border Radius)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Border Grid.Column="1" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2">
                            <TextBlock Text="{Binding RadioBordesPx, StringFormat='{}{0:F0} px'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                        </Border>
                    </Grid>
                    <Slider Minimum="0" Maximum="24" Value="{Binding RadioBordesPx, Mode=TwoWay}" />

                    <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
                        <ToggleSwitch Grid.Column="0" IsChecked="{Binding ShowProductImages, Mode=TwoWay}" OffContent="Imagen" OnContent="Imagen" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowStockBadge, Mode=TwoWay}" OffContent="Badge Stock" OnContent="Badge Stock" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*">
                        <ToggleSwitch Grid.Column="0" IsChecked="{Binding ShowQuickAddButton, Mode=TwoWay}" OffContent="Botón (+)" OnContent="Botón (+)" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableHoverZoom, Mode=TwoWay}" OffContent="Hover Zoom" OnContent="Hover Zoom" />
                    </Grid>
                </StackPanel>

                <!-- 2.6 SUB-TAB ANIMACIONES -->
                <StackPanel IsVisible="{Binding IsSubAnimaciones}" Spacing="14">
                    <TextBlock Text="Motor Cinemático &amp; Transiciones" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Duración de Transición" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Border Grid.Column="1" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2">
                            <TextBlock Text="{Binding DuracionTransicionMs, StringFormat='{}{0:F0} ms'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                        </Border>
                    </Grid>
                    <Slider Minimum="0" Maximum="400" Value="{Binding DuracionTransicionMs, Mode=TwoWay}" />

                    <Grid ColumnDefinitions="*,*">
                        <ToggleSwitch Grid.Column="0" IsChecked="{Binding EnableAnimations, Mode=TwoWay}" OffContent="Transiciones" OnContent="Transiciones" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableHoverEffects, Mode=TwoWay}" OffContent="Efecto Hover" OnContent="Efecto Hover" />
                    </Grid>
                </StackPanel>

            </StackPanel>

            <!-- ─── RIGHT COLUMN: MANDATORY LIVE INTERACTIVE COMPONENT PREVIEW BOX ─── -->
            <Border Grid.Column="1" Background="{DynamicResource BgPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource AppCornerRadius}" Padding="14">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="PREVISUALIZACIÓN EN TIEMPO REAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />

                    <StackPanel Spacing="14" VerticalAlignment="Center">

                        <!-- 1. Mini Topbar Header Preview -->
                        <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}" Padding="10,8">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="{DynamicResource AppLogoHeight}" Height="{DynamicResource AppLogoHeight}" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="NV" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding EmpresaNombreComercial}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>

                        <!-- 2. Mini Live POS Product Card Preview -->
                        <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{Binding GrosorBordePx}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="12">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Border IsVisible="{Binding ShowStockBadge}" Background="#10B981" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2">
                                        <TextBlock Text="Stock: 45 pza" FontSize="9" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <mi:MaterialIcon Grid.Column="1" Kind="Barcode" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding ShowSkuProducto}" />
                                </Grid>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="Refresco Cola 600ml" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Bebidas / Abarrotes" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="$19.00 MXN" FontSize="{DynamicResource PosPriceFontSize}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" IsVisible="{Binding ShowQuickAddButton}" Content="+ AGREGAR" Padding="8,4" FontSize="10" FontWeight="Bold" Classes="primary-action" CornerRadius="{DynamicResource AppCornerRadius}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. Mini Call-to-Action Payment Buttons Preview -->
                        <StackPanel Spacing="8">
                            <Button Content="[ COBRAR TICKET $116.00 ]" Padding="10" FontSize="11" FontWeight="Bold"
                                    Background="{DynamicResource AccentSuccessBrush}" Foreground="White" CornerRadius="{DynamicResource AppCornerRadius}" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" />

                            <Button Content="CANCELAR / ANULAR VENTA" Padding="8" FontSize="10" FontWeight="Bold"
                                    Background="{DynamicResource AccentDangerBrush}" Foreground="White" CornerRadius="{DynamicResource AppCornerRadius}" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" />
                        </StackPanel>

                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>

