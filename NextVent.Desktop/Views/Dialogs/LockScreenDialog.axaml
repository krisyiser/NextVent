<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NextVent.ViewModels.Dialogs"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="NextVent.Views.Dialogs.LockScreenDialog"
             x:DataType="vm:LockScreenDialogViewModel">

    <Grid Background="#E60F172A">
        <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                CornerRadius="12" Padding="28">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <Border Background="#EFF6FF" CornerRadius="40" Width="64" Height="64" HorizontalAlignment="Center">
                    <mi:MaterialIcon Kind="LockOutline" Width="32" Height="32" Foreground="#2563EB" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="Terminal Bloqueada" FontSize="20" FontWeight="ExtraBold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CashierName, StringFormat='Cajero: {0}'}" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Ingrese PIN de 4 dígitos (Cajero o Supervisor) para desbloquear" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center"/>

                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="48" Width="220">
                    <TextBlock Text="{Binding EnteredPin}" FontSize="24" FontWeight="Bold" LetterSpacing="12" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0F172A"/>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Height="18"/>

                <!-- Numeric Keypad -->
                <Grid RowDefinitions="46, 46, 46, 46" ColumnDefinitions="64, 64, 64">
                    <Button Grid.Row="0" Grid.Column="0" Content="1" Command="{Binding AppendPinDigitCommand}" CommandParameter="1" Margin="2" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="2" Command="{Binding AppendPinDigitCommand}" CommandParameter="2" Margin="2" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="3" Command="{Binding AppendPinDigitCommand}" CommandParameter="3" Margin="2" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                    <Button Grid.Row="1" Grid.Column="0" Content="4" Command="{Binding AppendPinDigitCommand}" CommandParameter="4" Margin="2" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="5" Command="{Binding AppendPinDigitCommand}" CommandParameter="5" Margin="2" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="6" Command="{Binding AppendPinDigitCommand}" CommandParameter="6" Margin="2" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                    <Button Grid.Row="2" Grid.Column="0" Content="7" Command="{Binding AppendPinDigitCommand}" CommandParameter="7" Margin="2" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="8" Command="{Binding AppendPinDigitCommand}" CommandParameter="8" Margin="2" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="9" Command="{Binding AppendPinDigitCommand}" CommandParameter="9" Margin="2" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                    <Button Grid.Row="3" Grid.Column="0" Content="C" Command="{Binding ClearPinCommand}" Margin="2" Background="#FEF2F2" Foreground="#EF4444" FontWeight="Bold" CornerRadius="6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Grid.Row="3" Grid.Column="1" Content="0" Command="{Binding AppendPinDigitCommand}" CommandParameter="0" Margin="2" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
