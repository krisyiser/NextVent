<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NextVent.ViewModels.Dialogs"
             x:Class="NextVent.Views.Dialogs.ProductDialog"
             x:DataType="vm:ProductDialogViewModel">

    <Border Width="540" Padding="24" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,20">
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Ingrese el código de barras, descripción, precios, número de serie y atributos del producto." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0" Spacing="12">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource AccentDangerBrush}" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" />

                <Grid ColumnDefinitions="*,*">
                    <Button Grid.Column="0" Command="{Binding CancelCommand}" Content="Cancelar" Margin="0,0,6,0" Padding="12"
                            Background="{DynamicResource BgPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Foreground="{DynamicResource TextPrimaryBrush}" CornerRadius="6" HorizontalContentAlignment="Center" />

                    <Button Grid.Column="1" Command="{Binding SaveCommand}" Content="Guardar Producto" Margin="6,0,0,0" Padding="12"
                            Classes="primary-action" FontWeight="Bold" CornerRadius="6" HorizontalContentAlignment="Center" />
                </Grid>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4" Margin="0,0,8,0">
                            <TextBlock Text="Código de Barras / SKU *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding Barcode, Mode=TwoWay}" Watermark="Ej. 7501000000001" Background="{DynamicResource BgTertiaryBrush}" Padding="10" />
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding GenerateBarcodeCommand}" Content="Generar SKU" VerticalAlignment="Bottom" Padding="12,10"
                                Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Foreground="{DynamicResource AccentPrimaryBrush}" />
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Nombre del Producto *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="Ej. Leche Entera 1 Litro" Background="{DynamicResource BgTertiaryBrush}" Padding="10" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*,*">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                            <TextBlock Text="Precio Costo ($)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding CostPrice, Mode=TwoWay}" Watermark="0.00" Background="{DynamicResource BgTertiaryBrush}" Padding="10" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4" Margin="2,0,2,0">
                            <TextBlock Text="Precio Venta ($) *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding SalePrice, Mode=TwoWay}" Watermark="0.00" Background="{DynamicResource BgTertiaryBrush}" Padding="10" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4" Margin="4,0,0,0">
                            <TextBlock Text="Stock Inicial *" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding Stock, Mode=TwoWay}" Watermark="0" Background="{DynamicResource BgTertiaryBrush}" Padding="10" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Categoría" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding Category, Mode=TwoWay}" Watermark="Ej. Abarrotes / Bebidas / Electrónica" Background="{DynamicResource BgTertiaryBrush}" Padding="10" />
                    </StackPanel>

                    <!-- Sprint K: Atributos y Números de Serie / IMEIs -->
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4" />

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                            <TextBlock Text="Número de Serie / IMEI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            <TextBox Text="{Binding SerialNumber, Mode=TwoWay}" Watermark="Ej. SN-89123871298" Background="{DynamicResource BgTertiaryBrush}" Padding="8" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                            <TextBlock Text="Atributos (Talla, Color, Garantía)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            <TextBox Text="{Binding AttributesText, Mode=TwoWay}" Watermark="Ej. Talla: M, Color: Negro" Background="{DynamicResource BgTertiaryBrush}" Padding="8" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4" />

                    <!-- Loyalty, Reordering & SAT Integration Fields -->
                    <Grid ColumnDefinitions="*,*,*">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                            <TextBlock Text="⭐ Puntos de Regalo" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            <TextBox Text="{Binding PointsRewarded, Mode=TwoWay}" Watermark="1.0" Background="{DynamicResource BgTertiaryBrush}" Padding="8" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4" Margin="2,0,2,0">
                            <TextBlock Text="📦 Cant. Reabastecer" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentWarningBrush}" />
                            <TextBox Text="{Binding ReorderQuantity, Mode=TwoWay}" Watermark="10.0" Background="{DynamicResource BgTertiaryBrush}" Padding="8" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4" Margin="4,0,0,0">
                            <TextBlock Text="📍 Pasillo / Anaquel" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding LocationRack, Mode=TwoWay}" Watermark="Pasillo 1 - A" Background="{DynamicResource BgTertiaryBrush}" Padding="8" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                            <TextBlock Text="📄 Clave Prod/Serv SAT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding ClaveSat, Mode=TwoWay}" Watermark="50202306" Background="{DynamicResource BgTertiaryBrush}" Padding="8" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                            <TextBlock Text="📄 Clave Unidad SAT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding UnidadSat, Mode=TwoWay}" Watermark="H87" Background="{DynamicResource BgTertiaryBrush}" Padding="8" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
