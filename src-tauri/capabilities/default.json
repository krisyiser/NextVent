{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "log:default",
    {
      "identifier": "sql:allow-load",
      "scope": {
        "allow": ["sqlite:app.db"]
      }
    },
    {
      "identifier": "sql:allow-execute",
      "scope": {
        "allow": ["sqlite:app.db"]
      }
    },
    {
      "identifier": "sql:allow-select",
      "scope": {
        "allow": ["sqlite:app.db"]
      }
    }
  ]
}
