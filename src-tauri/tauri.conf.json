{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NextVent",
  "version": "0.1.0",
  "identifier": "com.zimatechnologies.nextvent",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NextVent POS",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "visible": false,
        "fullscreen": false
      },
      {
        "label": "splashscreen",
        "title": "Cargando...",
        "width": 500,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "url": "/splash.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "./installer/licencia.txt",
    "resources": ["productos_base.db"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "./installer/header.bmp",
        "sidebarImage": "./installer/sidebar.bmp",
        "installerIcon": "./installer/installerIcon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": true
      }
    }
  }
}
