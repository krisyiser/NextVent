<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:expenses="using:Ticketfy.Views.Expenses"
             x:Class="Ticketfy.Views.ExpensesView"
             x:DataType="vm:ExpensesViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Margin="16">

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="16,12"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource AccentDangerBrush}">
                        <mi:MaterialIcon Kind="CashMinus" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Control de Gastos Operativos y Balance de Utilidad Neta Real" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Registro de egresos y cálculo financiero (Ventas - Costos - Gastos)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding FeedbackMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccessBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 2. Financial Metrics Cards (Ventas, Costos, Utilidad Bruta, Gastos, UTILIDAD NETA) -->
        <expenses:NetProfitAnalyticsView Grid.Row="1" Margin="0,0,0,16" />

        <!-- 3. Main Workspace (Left: Register Expense Form, Right: Expenses Table) -->
        <expenses:ExpenseEntryView Grid.Row="2" />

    </Grid>
</UserControl>

