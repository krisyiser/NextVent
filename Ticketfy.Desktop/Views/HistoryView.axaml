<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:history="using:Ticketfy.Views.History"
             x:Class="Ticketfy.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Margin="16">

        <!-- ═══ 1. TOP FUNCTION BANNER BAR ═══ -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="16,12"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}">
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Width="36" Height="36" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource AccentPrimaryBrush}">
                        <mi:MaterialIcon Kind="History" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Auditória de Ventas, Hora Pico y Corte final" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Historial Chronológico, Desglose por Hora e Impresión de Tickets" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Status Feedback & Action Buttons Header -->
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="De:" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0" />
                    <CalendarDatePicker SelectedDate="{Binding StartDate}" Width="120" Margin="4,0" CustomDateFormatString="dd/MM/yyyy" />
                    <TextBlock Text="A:" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0" />
                    <CalendarDatePicker SelectedDate="{Binding EndDate}" Width="120" Margin="4,0" CustomDateFormatString="dd/MM/yyyy" />
                    <Button Command="{Binding FetchSalesHistoryCommand}" Margin="4,0" Padding="10,6" CornerRadius="{DynamicResource AppCornerRadius}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <mi:MaterialIcon Kind="Filter" Width="14" Height="14" />
                            <TextBlock Text="FILTRAR" FontSize="11" FontWeight="Bold" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{Binding FeedbackMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccessBrush}" VerticalAlignment="Center" Margin="12,4" />

                    <!-- Cashup Audit Button -->
                    <Button Command="{Binding PerformCashCutoffCommand}" Margin="0,2,0,2" Padding="12,6" CornerRadius="{DynamicResource AppCornerRadius}"
                            Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource AccentWarningBrush}" BorderThickness="2" ToolTip.Tip="Abrir matriz de arqueo físico por billetes y monedas">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="CashMultiple" Width="16" Height="16" Foreground="{DynamicResource AccentWarningBrush}" />
                            <TextBlock Text="ARQUEO DE CAJA" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentWarningBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ═══ 2. TABS CONTENT ═══ -->
        <TabControl Grid.Row="1" Grid.RowSpan="2" Margin="0,0,0,0">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,2">
                        <mi:MaterialIcon Kind="ChartLine" Width="18" Height="18" />
                        <TextBlock Text="Ventas y Rendimiento" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <!-- Panel: Ventas y Rendimiento -->
                <Grid x:Name="HistorySalesAreaSection" RowDefinitions="Auto,Auto,*" Margin="0,16,0,0">
                    <!-- ═══ 2. HOURLY SALES & PEAK HOUR CARD ═══ -->
                    <history:HistoryHourlyReportView Grid.Row="0" Margin="0,0,0,16" />

                    <!-- ═══ 3. CASHIER PERFORMANCE & COMMISSIONS CARD ═══ -->
                    <history:CashierPerformanceView Grid.Row="1" Margin="0,0,0,16" />

                    <!-- ═══ 4. MAIN TRANSACTIONS TABLE ═══ -->
                    <history:HistorySalesTableView x:Name="HistoryRecordsSection" Grid.Row="2" />
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,2">
                        <mi:MaterialIcon Kind="CashRegister" Width="18" Height="18" />
                        <TextBlock Text="Registro de cortes de caja y cortes de turno" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <!-- Panel: Registro de Arqueos -->
                <history:HistoryCashupsTableView Margin="0,16,0,0" />
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>

