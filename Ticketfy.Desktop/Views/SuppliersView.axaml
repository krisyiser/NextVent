<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:suppliers="using:Ticketfy.Views.Suppliers"
             x:Class="Ticketfy.Views.SuppliersView"
             x:DataType="vm:SuppliersViewModel">

    <Grid RowDefinitions="Auto,*" Margin="16">

        <!-- Header Banner -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="16,12"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource AccentPrimaryBrush}">
                        <mi:MaterialIcon Kind="TruckDelivery" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Gestión de Proveedores y Órdenes de Compra" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Entradas de Mercancía y Reabastecimiento de Inventario" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding FeedbackMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccessBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main Body (Tabs) -->
        <TabControl Grid.Row="1" Margin="0,8,0,0">
            <TabItem Header="Reabastecer Inventario" FontSize="14" FontWeight="SemiBold">
                <suppliers:PurchaseOrderView Margin="0,16,0,0" />
            </TabItem>
            <TabItem Header="Directorio de Proveedores" FontSize="14" FontWeight="SemiBold">
                <suppliers:SuppliersDirectoryView Margin="0,16,0,0" />
            </TabItem>
            <TabItem Header="Historial de Compras" FontSize="14" FontWeight="SemiBold">
                <suppliers:PurchaseHistoryView Margin="0,16,0,0" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

