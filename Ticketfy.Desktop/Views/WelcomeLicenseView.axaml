<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Ticketfy.Views.WelcomeLicenseView"
             x:DataType="vm:WelcomeLicenseViewModel">

    <Grid Background="{DynamicResource BgPrimaryBrush}">
        <Border Width="520" Padding="32" CornerRadius="12"
                Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="22">
                <!-- Header Icon & Titles -->
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <Border Width="64" Height="64" CornerRadius="12" Background="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="ShieldCheck" Width="38" Height="38" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="¡Bienvenido a Ticketfy POS!" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Sistema Industrial de Gestión &amp; Punto de Venta" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- License Status & Instruction Card -->
                <Border Padding="14" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,*">
                            <mi:MaterialIcon Kind="CheckCircleOutline" Width="20" Height="20" Foreground="{DynamicResource AccentSuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding LicenseStatusText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Active su clave de licencia comercial para desbloquear todas las funciones enterprise o continúe con la configuración inicial." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="28,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- License Input Field -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Clave / Token de Licencia (JWT)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding LicenseTokenInput, Mode=TwoWay}" Watermark="Ingrese o pegue aquí su Token de Licencia (license.jwt)" Background="{DynamicResource BgTertiaryBrush}" Padding="12" AcceptsReturn="False" />
                </StackPanel>

                <!-- Error & Success Messages -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource AccentDangerBrush}" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource AccentSuccessBrush}" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Action Button -->
                <Button Command="{Binding ActivateLicenseAndContinueCommand}" Classes="primary-action" Height="46" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <mi:MaterialIcon Kind="Key" Width="20" Height="20" Foreground="White" />
                        <TextBlock Text="ACTIVAR LICENCIA Y CONTINUAR" FontWeight="Bold" FontSize="14" Foreground="White" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
