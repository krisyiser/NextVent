<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:controls="using:Ticketfy.Controls"
             x:Class="Ticketfy.Views.SetupBusinessDataView"
             x:DataType="vm:SetupBusinessDataViewModel">

    <Grid Background="{DynamicResource BgPrimaryBrush}">
        <Border Width="460" Padding="32" CornerRadius="12"
                Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="20">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <Border Width="56" Height="56" CornerRadius="8" Background="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="Storefront" Width="32" Height="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Datos del Negocio" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Configure la información principal de su comercio" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Spacing="14">
                    <!-- 1. Nombre del Negocio -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Nombre del Negocio *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding BusinessName, Mode=TwoWay}" Watermark="Ej. Abarrotes San José" Background="{DynamicResource BgTertiaryBrush}" Padding="10,8" />
                    </StackPanel>

                    <!-- 2. Teléfono del Negocio (10 dígitos obligatorio) -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Teléfono de Contacto (10 dígitos) *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <controls:PhoneTextBox x:Name="PhoneInput" Text="{Binding Phone, Mode=TwoWay}" Watermark="Ej. 5512345678" Background="{DynamicResource BgTertiaryBrush}" Padding="10,8" />
                    </StackPanel>

                    <!-- 3. Correo Electrónico Principal -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Correo Electrónico Principal (Opcional)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding Email, Mode=TwoWay}" Watermark="contacto@negocio.com" Background="{DynamicResource BgTertiaryBrush}" Padding="10,8" />
                    </StackPanel>

                    <!-- 4. Dirección del Negocio -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Dirección / Ubicación (Opcional)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding Address, Mode=TwoWay}" Watermark="Ej. Av. Hidalgo #123, Col. Centro" Background="{DynamicResource BgTertiaryBrush}" Padding="10,8" />
                    </StackPanel>

                    <controls:AlertBannerControl Message="{Binding ErrorMessage}" IsError="True" />
                </StackPanel>

                <Button Command="{Binding SaveAndContinueCommand}" Classes="primary-action" Height="44" HorizontalAlignment="Stretch">
                    <TextBlock Text="GUARDAR Y CONTINUAR" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
