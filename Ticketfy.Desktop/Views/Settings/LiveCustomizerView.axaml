<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmsettings="using:Ticketfy.ViewModels.Settings"
             xmlns:models="using:Ticketfy.Core.Models.Settings"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Ticketfy.Views.Settings.LiveCustomizerView"
             x:DataType="vmsettings:UnifiedSettingsViewModel">

    <!-- 2-COLUMN LAYOUT: GRANULAR STYLES STUDIO (LEFT) vs REAL-TIME COMPONENT PREVIEW BOX (RIGHT) -->
    <Grid ColumnDefinitions="*,320">

        <!-- ─── LEFT COLUMN: GRANULAR STYLES STUDIO ─── -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
            <StackPanel Spacing="16">

                <!-- 1. Presets de Temas Base -->
                <Border Padding="14" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Preset de Tema &amp; Apariencia" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <UniformGrid Columns="3">
                            <Button Command="{Binding SelectThemeCommand}" CommandParameter="Modo Oscuro" Margin="2" Padding="8" CornerRadius="{DynamicResource AppCornerRadius}" Background="#090D16" BorderBrush="#334155" BorderThickness="1">
                                <TextBlock Text="Modo Oscuro" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                            </Button>
                            <Button Command="{Binding SelectThemeCommand}" CommandParameter="Modo Claro" Margin="2" Padding="8" CornerRadius="{DynamicResource AppCornerRadius}" Background="#F4F6F8" BorderBrush="#E5E7EB" BorderThickness="1">
                                <TextBlock Text="Modo Claro" FontSize="11" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" />
                            </Button>
                            <Button Command="{Binding SelectThemeCommand}" CommandParameter="Nordic Slate" Margin="2" Padding="8" CornerRadius="{DynamicResource AppCornerRadius}" Background="#1E293B" BorderBrush="#94A3B8" BorderThickness="1">
                                <TextBlock Text="Nordic Slate" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                            </Button>
                            <Button Command="{Binding SelectThemeCommand}" CommandParameter="Cyberpunk Dark" Margin="2" Padding="8" CornerRadius="{DynamicResource AppCornerRadius}" Background="#09090B" BorderBrush="#8B5CF6" BorderThickness="1">
                                <TextBlock Text="Cyberpunk" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" />
                            </Button>
                            <Button Command="{Binding SelectThemeCommand}" CommandParameter="Emerald Glass" Margin="2" Padding="8" CornerRadius="{DynamicResource AppCornerRadius}" Background="#022C22" BorderBrush="#34D399" BorderThickness="1">
                                <TextBlock Text="Emerald Glass" FontSize="11" FontWeight="Bold" Foreground="#A7F3D0" HorizontalAlignment="Center" />
                            </Button>
                            <Button Command="{Binding SelectThemeCommand}" CommandParameter="Alto Contraste" Margin="2" Padding="8" CornerRadius="{DynamicResource AppCornerRadius}" Background="#000000" BorderBrush="#FFFFFF" BorderThickness="1">
                                <TextBlock Text="Alto Contraste" FontSize="11" FontWeight="Bold" Foreground="#FACC15" HorizontalAlignment="Center" />
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 2. Paleta de Color de Acento Principal -->
                <Border Padding="14" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Color de Acento de Identidad" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ItemsControl ItemsSource="{Binding AccentColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding $parent[UserControl].((vmsettings:UnifiedSettingsViewModel)DataContext).SelectPrimaryColorCommand}"
                                            CommandParameter="{Binding HexColor}"
                                            Margin="2" Padding="6" Height="36" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgTertiaryBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <Border Width="14" Height="14" CornerRadius="7" Background="{Binding HexColor}" />
                                            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 3. Tipografía & Escalamiento de Texto -->
                <Border Padding="14" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Tipografía &amp; Escalamiento de Fuente" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        
                        <StackPanel Spacing="4">
                            <TextBlock Text="Familia Tipográfica" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding AvailableFontOptions}" SelectedItem="{Binding State.Visual.FontFamily, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8,6" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Tamaño Base de Fuente (UI)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2">
                                <TextBlock Text="{Binding State.Visual.FontSizeScale, StringFormat='{}{0:F0} px'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            </Border>
                        </Grid>
                        <Slider Minimum="12" Maximum="18" Value="{Binding State.Visual.FontSizeScale, Mode=TwoWay}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Tamaño de Precios Monospaciados POS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2">
                                <TextBlock Text="{Binding State.Visual.PosPriceFontSize, StringFormat='{}{0:F0} px'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            </Border>
                        </Grid>
                        <Slider Minimum="18" Maximum="36" Value="{Binding State.Visual.PosPriceFontSize, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- 4. Geometría, Radio de Bordes & Densidad Espacial -->
                <Border Padding="14" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Geometría, Radio de Bordes &amp; Densidad Espacial" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Radio de Curvatura de Bordes (Corner Radius)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2">
                                <TextBlock Text="{Binding State.Visual.CornerRadius, StringFormat='{}{0:F0} px'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            </Border>
                        </Grid>
                        <Slider Minimum="0" Maximum="24" Value="{Binding State.Visual.CornerRadius, Mode=TwoWay}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Ancho de Carrito POS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2">
                                <TextBlock Text="{Binding State.Visual.PosCartWidth, StringFormat='{}{0:F0} px'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            </Border>
                        </Grid>
                        <Slider Minimum="300" Maximum="550" Value="{Binding State.Visual.PosCartWidth, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ─── RIGHT COLUMN: MANDATORY LIVE INTERACTIVE COMPONENT PREVIEW BOX ─── -->
        <Border Grid.Column="1" Background="{DynamicResource BgPrimaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource AppCornerRadius}" Padding="14">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="PREVISUALIZACIÓN EN TIEMPO REAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />

                <StackPanel Spacing="14" VerticalAlignment="Center">
                    <!-- 1. Mini Topbar Header Preview -->
                    <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}" Padding="10,8">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="28" Height="28" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="TF" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding State.Company.CommercialName}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <!-- 2. Mini Live POS Product Card Preview -->
                    <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Border IsVisible="{Binding State.Visual.ShowStockBadge}" Background="{DynamicResource AccentSuccessBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2">
                                    <TextBlock Text="Stock: 45 pza" FontSize="9" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <mi:MaterialIcon Grid.Column="1" Kind="Barcode" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding State.Visual.ShowSkuProducto}" />
                            </Grid>

                            <StackPanel Spacing="2">
                                <TextBlock Text="Refresco Cola 600ml" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Bebidas / Abarrotes" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="$19.00 MXN" FontSize="{DynamicResource PosPriceFontSize}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" IsVisible="{Binding State.Visual.ShowQuickAddButton}" Content="+ AGREGAR" Padding="8,4" FontSize="10" FontWeight="Bold" Classes="primary-action" CornerRadius="{DynamicResource AppCornerRadius}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3. Mini Call-to-Action Payment Buttons Preview -->
                    <StackPanel Spacing="8">
                        <Button Content="[ COBRAR TICKET $116.00 ]" Padding="10" FontSize="11" FontWeight="Bold"
                                Background="{DynamicResource AccentSuccessBrush}" Foreground="White" CornerRadius="{DynamicResource AppCornerRadius}" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" />

                        <Button Content="CANCELAR / ANULAR VENTA" Padding="8" FontSize="10" FontWeight="Bold"
                                Background="{DynamicResource AccentDangerBrush}" Foreground="White" CornerRadius="{DynamicResource AppCornerRadius}" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" />
                    </StackPanel>

                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
