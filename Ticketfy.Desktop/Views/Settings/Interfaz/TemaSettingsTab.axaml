<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             x:Class="Ticketfy.Views.Settings.Interfaz.TemaSettingsTab"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="14">
        <TextBlock Text="Modos &amp; Textura de Fondo (7 Presets)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
        
        <UniformGrid Columns="2">
            <Button Command="{Binding SelectThemeCommand}" CommandParameter="Modo Claro" Margin="0,0,4,6" Padding="10" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgPrimaryBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="2">
                <TextBlock Text="Modo Claro" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
            </Button>
            <Button Command="{Binding SelectThemeCommand}" CommandParameter="Modo Oscuro" Margin="4,0,0,6" Padding="10" CornerRadius="{DynamicResource AppCornerRadius}" Background="#0F172A" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <TextBlock Text="Modo Oscuro" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
            </Button>
            <Button Command="{Binding SelectThemeCommand}" CommandParameter="Alto Contraste" Margin="0,0,4,6" Padding="10" CornerRadius="{DynamicResource AppCornerRadius}" Background="#000000" BorderBrush="#FFFFFF" BorderThickness="2">
                <TextBlock Text="Alto Contraste" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentWarningBrush}" HorizontalAlignment="Center" />
            </Button>
            <Button Command="{Binding SelectThemeCommand}" CommandParameter="Cyberpunk Dark" Margin="4,0,0,6" Padding="10" CornerRadius="{DynamicResource AppCornerRadius}" Background="#09090B" BorderBrush="#8B5CF6" BorderThickness="2">
                <TextBlock Text="Cyberpunk Dark" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" />
            </Button>
            <Button Command="{Binding SelectThemeCommand}" CommandParameter="Emerald Glass" Margin="0,0,4,0" Padding="10" CornerRadius="{DynamicResource AppCornerRadius}" Background="#022C22" BorderBrush="#34D399" BorderThickness="2">
                <TextBlock Text="Emerald Glass" FontSize="12" FontWeight="Bold" Foreground="#A7F3D0" HorizontalAlignment="Center" />
            </Button>
            <Button Command="{Binding SelectThemeCommand}" CommandParameter="Nordic Slate" Margin="4,0,0,0" Padding="10" CornerRadius="{DynamicResource AppCornerRadius}" Background="#1E293B" BorderBrush="#94A3B8" BorderThickness="1">
                <TextBlock Text="Nordic Slate" FontSize="12" FontWeight="Bold" Foreground="#F1F5F9" HorizontalAlignment="Center" />
            </Button>
        </UniformGrid>

        <!-- Glassmorphism Sliders -->
        <StackPanel Spacing="10" Margin="0,6,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Desenfoque Glassmorphism (Blur)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Border Grid.Column="1" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2">
                    <TextBlock Text="{Binding GlassmorphismBlur, StringFormat='{}{0:F0} px'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                </Border>
            </Grid>
            <Slider Minimum="0" Maximum="24" Value="{Binding GlassmorphismBlur, Mode=TwoWay}" />

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Opacidad de Tarjetas Contenedoras" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Border Grid.Column="1" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2">
                    <TextBlock Text="{Binding GlassmorphismOpacity, StringFormat='{}{0:F0} %'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                </Border>
            </Grid>
            <Slider Minimum="20" Maximum="100" Value="{Binding GlassmorphismOpacity, Mode=TwoWay}" />
        </StackPanel>
    </StackPanel>
</UserControl>
