<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmsettings="using:Ticketfy.ViewModels.Settings"
             x:Class="Ticketfy.Views.Settings.Interfaz.DisposicionSettingsTab"
             x:DataType="vmsettings:InterfazSettingsViewModel">

    <StackPanel Spacing="14">
        <TextBlock Text="Disposición de Espacio POS &amp; Densidad" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />

        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,8" Spacing="4">
                <TextBlock Text="Posición del Carrito" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding PosicionCarritoOptions}" SelectedItem="{Binding PosicionCarrito, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8,6" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,8" Spacing="4">
                <TextBlock Text="Posición de Barra Lateral" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding PosicionSidebarOptions}" SelectedItem="{Binding SidebarPosition, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8,6" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,8" Spacing="4">
                <TextBlock Text="Columnas de Matriz" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding ProductGridColumnsOptions}" SelectedItem="{Binding SelectedProductGridColumns, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8,6" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,8" Spacing="4">
                <TextBlock Text="Densidad Espacial" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding ModoDensidadOptions}" SelectedItem="{Binding ModoDensidadEspacial, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="8,6" />
            </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Ancho del Carrito POS" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Border Grid.Column="1" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2">
                <TextBlock Text="{Binding AnchoCarritoPx, StringFormat='{}{0:F0} px'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
            </Border>
        </Grid>
        <Slider Minimum="300" Maximum="550" Value="{Binding AnchoCarritoPx, Mode=TwoWay}" />
    </StackPanel>
</UserControl>
