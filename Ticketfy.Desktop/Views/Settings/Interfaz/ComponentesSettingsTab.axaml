<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             x:Class="Ticketfy.Views.Settings.Interfaz.ComponentesSettingsTab"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="14">
        <TextBlock Text="Geometría, Sombras &amp; Switches de Tarjeta" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />

        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Radio de Bordes (Border Radius)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Border Grid.Column="1" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2">
                <TextBlock Text="{Binding RadioBordesPx, StringFormat='{}{0:F0} px'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
            </Border>
        </Grid>
        <Slider Minimum="0" Maximum="24" Value="{Binding RadioBordesPx, Mode=TwoWay}" />

        <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
            <ToggleSwitch Grid.Column="0" IsChecked="{Binding ShowProductImages, Mode=TwoWay}" OffContent="Imagen" OnContent="Imagen" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowStockBadge, Mode=TwoWay}" OffContent="Badge Stock" OnContent="Badge Stock" />
        </Grid>
        <Grid ColumnDefinitions="*,*">
            <ToggleSwitch Grid.Column="0" IsChecked="{Binding ShowQuickAddButton, Mode=TwoWay}" OffContent="Botón (+)" OnContent="Botón (+)" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableHoverZoom, Mode=TwoWay}" OffContent="Hover Zoom" OnContent="Hover Zoom" />
        </Grid>
    </StackPanel>
</UserControl>
