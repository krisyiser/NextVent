<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmsettings="using:Ticketfy.ViewModels.Settings"
             x:Class="Ticketfy.Views.Settings.Interfaz.AnimacionesSettingsTab"
             x:DataType="vmsettings:InterfazSettingsViewModel">

    <StackPanel Spacing="14">
        <TextBlock Text="Animaciones &amp; Transiciones de Interfaz" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />

        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Duración de Transición" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Border Grid.Column="1" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" Padding="6,2">
                <TextBlock Text="{Binding DuracionTransicionMs, StringFormat='{}{0:F0} ms'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
            </Border>
        </Grid>
        <Slider Minimum="60" Maximum="300" Value="{Binding DuracionTransicionMs, Mode=TwoWay}" />

        <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
            <ToggleSwitch Grid.Column="0" IsChecked="{Binding EnableAnimations, Mode=TwoWay}" OffContent="Animaciones" OnContent="Animaciones" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableHoverEffects, Mode=TwoWay}" OffContent="Efectos Hover" OnContent="Efectos Hover" />
        </Grid>
    </StackPanel>
</UserControl>
