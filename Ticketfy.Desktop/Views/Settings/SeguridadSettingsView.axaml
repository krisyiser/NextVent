<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             x:Class="Ticketfy.Views.Settings.SeguridadSettingsView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="18">
        <TextBlock Text="Seguridad &amp; Encriptación Local" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
        
        <Border Padding="16" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel Spacing="12">
                <TextBlock Text="Base de Datos Encriptada (SQLCipher 256-bit AES)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentSuccessBrush}" />
                <TextBlock Text="Todas las transacciones y contraseñas de cajero están aseguradas localmente en app.db." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

