<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:settings="using:Ticketfy.Views.Settings"
             x:Class="Ticketfy.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid Background="{DynamicResource BgPrimaryBrush}" Margin="16">
        <!-- Main Container Card -->
        <Border Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource AppCornerRadius}"
                ClipToBounds="True">
            <DockPanel LastChildFill="True">

                <!-- ═══ 1. TOP TITLE BAR ═══ -->
                <Border DockPanel.Dock="Top" Height="56"
                        Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="20,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <mi:MaterialIcon Kind="CogOutline" Width="22" Height="22" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            <TextBlock Text="Motor Unificado de Configuración &amp; Personalización" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ 2. BOTTOM ACTION FOOTER ═══ -->
                <Border DockPanel.Dock="Bottom" Height="64"
                        Background="{DynamicResource BgPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="20,12">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="{Binding FeedbackMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccessBrush}" VerticalAlignment="Center" />

                        <Button Grid.Column="1" Command="{Binding CloseCommand}" Content="Cancelar" Padding="20,10" Margin="0,0,12,0"
                                Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" CornerRadius="{DynamicResource AppCornerRadius}" Cursor="Hand" />

                        <Button Grid.Column="2" Command="{Binding SaveAllSettingsCommand}" Padding="20,10" Classes="primary-action" FontSize="13" FontWeight="Bold" CornerRadius="{DynamicResource AppCornerRadius}" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="ContentSave" Width="18" Height="18" />
                                <TextBlock Text="GUARDAR CONFIGURACIÓN" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ═══ 3. MAIN BODY (4 KEY OPERATIONAL AXES NAV + ISOLATED VIEWS) ═══ -->
                <Grid ColumnDefinitions="240,*">

                    <!-- ─── LEFT SIDEBAR NAVIGATION (4 KEY OPERATIONAL AXES) ─── -->
                    <Border Grid.Column="0" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Bottom" Padding="16,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding CurrentAppVersion, StringFormat='TICKETFY! {0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Valcore Engine 4.0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="6" Margin="8">
                                    <TextBlock Text="EJES DE CONFIGURACIÓN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,8,8,4" />

                                    <!-- 1. Personalización & UI -->
                                    <Button Command="{Binding UnifiedVM.SelectAxisTabCommand}" CommandParameter="ui" Padding="12,11" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgTertiaryBrush}" HorizontalAlignment="Stretch" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <mi:MaterialIcon Kind="PaletteOutline" Width="20" Height="20" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Personalización &amp; UI" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="Estilos, Colores &amp; Fuentes" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <!-- 2. Identidad & Empresa -->
                                    <Button Command="{Binding UnifiedVM.SelectAxisTabCommand}" CommandParameter="company" Padding="12,11" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgTertiaryBrush}" HorizontalAlignment="Stretch" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <mi:MaterialIcon Kind="Domain" Width="20" Height="20" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Identidad &amp; Empresa" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="Datos Comerciales &amp; Fiscales" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <!-- 3. Hardware & Tickets -->
                                    <Button Command="{Binding UnifiedVM.SelectAxisTabCommand}" CommandParameter="hardware" Padding="12,11" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgTertiaryBrush}" HorizontalAlignment="Stretch" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <mi:MaterialIcon Kind="PrinterOutline" Width="20" Height="20" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Hardware &amp; Tickets" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="Impresoras 58/80mm &amp; Lector" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <!-- 4. Sistema & Seguridad -->
                                    <Button Command="{Binding UnifiedVM.SelectAxisTabCommand}" CommandParameter="system" Padding="12,11" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgTertiaryBrush}" HorizontalAlignment="Stretch" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <mi:MaterialIcon Kind="ShieldCheckOutline" Width="20" Height="20" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Sistema &amp; Seguridad" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="Base de Datos, PIN &amp; Backup" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,8" />

                                    <!-- Usuarios & Acerca de (Acceso Rápido) -->
                                    <Button Command="{Binding SelectMainTabCommand}" CommandParameter="usuarios" Padding="12,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="Transparent" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <mi:MaterialIcon Kind="AccountGroupOutline" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="Usuarios &amp; Roles" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding SelectMainTabCommand}" CommandParameter="acercade" Padding="12,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="Transparent" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <mi:MaterialIcon Kind="InformationOutline" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="Acerca de Ticketfy" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- ─── UNIFIED MODULAR SUB-VIEW HOST ─── -->
                    <Grid Grid.Column="1" Margin="20">
                        <Panel IsVisible="{Binding UnifiedVM.IsUiTab}">
                            <settings:LiveCustomizerView DataContext="{Binding UnifiedVM}" />
                        </Panel>
                        <Panel IsVisible="{Binding UnifiedVM.IsCompanyTab}">
                            <settings:CompanyProfileView DataContext="{Binding UnifiedVM}" />
                        </Panel>
                        <Panel IsVisible="{Binding UnifiedVM.IsHardwareTab}">
                            <settings:HardwareTicketsView DataContext="{Binding UnifiedVM}" />
                        </Panel>
                        <Panel IsVisible="{Binding UnifiedVM.IsSystemTab}">
                            <settings:SystemSecurityView DataContext="{Binding UnifiedVM}" />
                        </Panel>
                        <Panel IsVisible="{Binding IsUsuariosTab}">
                            <settings:UsuariosSettingsView DataContext="{Binding UsuariosVM}" />
                        </Panel>
                        <Panel IsVisible="{Binding IsAcercaDeTab}">
                            <settings:AcercaDeSettingsView DataContext="{Binding AcercaDeVM}" />
                        </Panel>
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
