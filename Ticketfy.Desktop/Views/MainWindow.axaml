<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ticketfy.ViewModels"
        xmlns:vmDialogs="using:Ticketfy.ViewModels.Dialogs"
        xmlns:v="using:Ticketfy.Views"
        xmlns:vDialogs="using:Ticketfy.Views.Dialogs"
        xmlns:controls="using:Ticketfy.Controls"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="Ticketfy.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TICKETFY! — Sistema de Gestión de Punto de Venta"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.DataTemplates>
        <!-- Module View Templates -->
        <DataTemplate DataType="vm:PosViewModel"><v:PosView /></DataTemplate>
        <DataTemplate DataType="vm:InventoryViewModel"><v:InventoryView /></DataTemplate>
        <DataTemplate DataType="vm:CustomersViewModel"><v:CustomersView /></DataTemplate>
        <DataTemplate DataType="vm:SuppliersViewModel"><v:SuppliersView /></DataTemplate>
        <DataTemplate DataType="vm:ExpensesViewModel"><v:ExpensesView /></DataTemplate>
        <DataTemplate DataType="vm:HistoryViewModel"><v:HistoryView /></DataTemplate>
        <DataTemplate DataType="vm:PromotionsViewModel"><v:PromotionsView /></DataTemplate>
        <DataTemplate DataType="vm:FiscalViewModel"><v:FiscalView /></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="vm:LoginViewModel"><v:LoginView /></DataTemplate>
        <DataTemplate DataType="vm:FirstTimeSetupViewModel"><v:FirstTimeSetupView /></DataTemplate>
        <DataTemplate DataType="vm:SetupBusinessDataViewModel"><v:SetupBusinessDataView /></DataTemplate>
        <DataTemplate DataType="vm:SetupAdditionalUsersViewModel"><v:SetupAdditionalUsersView /></DataTemplate>
        <DataTemplate DataType="vm:LicenseLockedViewModel"><v:LicenseLockedView /></DataTemplate>

        <!-- Modal Dialog Templates -->
        <DataTemplate DataType="vmDialogs:CheckoutDialogViewModel"><vDialogs:CheckoutDialog /></DataTemplate>
        <DataTemplate DataType="vmDialogs:ProductDialogViewModel"><vDialogs:ProductDialog /></DataTemplate>
        <DataTemplate DataType="vmDialogs:CustomerDialogViewModel"><vDialogs:CustomerDialog /></DataTemplate>
        <DataTemplate DataType="vmDialogs:PromotionDialogViewModel"><vDialogs:PromotionDialog /></DataTemplate>
        <DataTemplate DataType="vmDialogs:PaymentDialogViewModel"><vDialogs:PaymentDialog /></DataTemplate>
        <DataTemplate DataType="vmDialogs:CashupDialogViewModel"><vDialogs:CashupDialog /></DataTemplate>
        <DataTemplate DataType="vmDialogs:CustomerStatementDialogViewModel"><vDialogs:CustomerStatementDialog /></DataTemplate>
        <DataTemplate DataType="vmDialogs:ItemKitDialogViewModel"><vDialogs:ItemKitDialog /></DataTemplate>
        <DataTemplate DataType="vmDialogs:ReturnDialogViewModel"><vDialogs:ReturnDialog /></DataTemplate>
        <DataTemplate DataType="vmDialogs:ShiftNotesDialogViewModel"><vDialogs:ShiftNotesDialog /></DataTemplate>
        <DataTemplate DataType="vmDialogs:SwitchUserPinDialogViewModel"><vDialogs:SwitchUserPinDialog /></DataTemplate>
        <DataTemplate DataType="vmDialogs:LockScreenDialogViewModel"><vDialogs:LockScreenDialog /></DataTemplate>
        <DataTemplate DataType="vmDialogs:SupervisorPinDialogViewModel"><vDialogs:SupervisorPinDialog /></DataTemplate>
        <DataTemplate DataType="vmDialogs:ConfirmDialogViewModel"><vDialogs:ConfirmDialog /></DataTemplate>
        <DataTemplate DataType="vmDialogs:ConfigureMinStockDialogViewModel"><vDialogs:ConfigureMinStockDialog /></DataTemplate>
        <DataTemplate DataType="vmDialogs:ManageCategoriesDialogViewModel"><vDialogs:ManageCategoriesDialog /></DataTemplate>
        <DataTemplate DataType="vmDialogs:OpenShiftDialogViewModel"><vDialogs:OpenShiftDialog /></DataTemplate>
    </Window.DataTemplates>

    <Panel>
        <DockPanel LastChildFill="True" Margin="0,30,0,0">
            <!-- ═══ SIDEBAR NAVIGATION ═══ -->
            <controls:SidebarNavigationControl />

            <!-- ═══ MAIN CONTENT AREA (UNTOUCHED STABLE LAYOUT) ═══ -->
            <ContentControl Content="{Binding ActiveViewModel}" IsEnabled="{Binding !IsLocked}" />
        </DockPanel>

        <!-- ═══ FLOATING UPDATE NOTIFICATION OVERLAY (ZERO LAYOUT SHIFT) ═══ -->
        <controls:UpdateBannerControl ZIndex="4000"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Margin="90,36,0,0" />

        <!-- ═══ MODAL DIALOG OVERLAY ═══ -->
        <Grid IsVisible="{Binding IsDialogOverlayOpen}" Background="#80000000">
            <ContentControl Content="{Binding ActiveDialogViewModel}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- ═══ TUTORIAL OVERLAY ═══ -->
        <v:TutorialOverlayView ZIndex="5000" DataContext="{Binding ActiveTutorialVm}" IsVisible="{Binding IsVisible}" />

        <!-- ═══ OVERLAY LOCK SCREEN ═══ -->
        <controls:LockScreenOverlay />

        <!-- ═══ SPLASH SCREEN OVERLAY ═══ -->
        <controls:SplashOverlay />
    </Panel>
</Window>
