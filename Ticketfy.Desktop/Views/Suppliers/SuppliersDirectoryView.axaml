<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             xmlns:dto="using:Ticketfy.Data.Dtos"
             x:Class="Ticketfy.Views.Suppliers.SuppliersDirectoryView"
             x:DataType="vm:SuppliersViewModel">

    <!-- Left Panel: Supplier Registry & Directory List -->
    <Border Padding="16"
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
                <TextBlock Text="Registrar Nuevo Proveedor" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*">
                    <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding SupplierName, Mode=TwoWay}" Watermark="Nombre Comercial *" Margin="0,0,4,8" Padding="10,8" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SupplierRfc, Mode=TwoWay}" Watermark="RFC Proveedor" Margin="4,0,0,8" Padding="10,8" />
                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding SupplierPhone, Mode=TwoWay}" Watermark="Teléfono de Contacto" Margin="0,0,4,8" Padding="10,8" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SupplierEmail, Mode=TwoWay}" Watermark="Correo Electrónico" Margin="4,0,0,8" Padding="10,8" />
                    <TextBox Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding SupplierContact, Mode=TwoWay}" Watermark="Persona de Contacto / Vendedor" Margin="0,0,0,8" Padding="10,8" />
                </Grid>
                <Button Command="{Binding SaveSupplierCommand}" Content="GUARDAR PROVEEDOR" Padding="16,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" />
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8,0,0" />
                <TextBlock Text="Directorio de Proveedores Registrados" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>

            <!-- Suppliers Table -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Suppliers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dto:SupplierDto">
                            <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Phone, StringFormat='Tel: {0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Rfc}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>

