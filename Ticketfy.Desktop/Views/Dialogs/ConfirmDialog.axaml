<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels.Dialogs"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Ticketfy.Views.Dialogs.ConfirmDialog"
             x:DataType="vm:ConfirmDialogViewModel">

    <Grid Background="#80000000">
        <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource AppCornerRadius}" Padding="24">
            <StackPanel Spacing="16">
                <!-- Header -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="HelpCircleOutline" Width="24" Height="24" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding CancelCommand}" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0">
                        <mi:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderBrush}" />

                <TextBlock Text="{Binding Message}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4"/>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*, *" Margin="0,8,0,0">
                    <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelCommand}" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,8" Margin="0,0,6,0"
                            Background="{DynamicResource BgTertiaryBrush}" CornerRadius="{DynamicResource AppCornerRadius}"/>
                    <Button Grid.Column="1" Content="Sí, Confirmar" Command="{Binding ConfirmCommand}" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,8" Margin="6,0,0,0"
                            Classes="primary-action" FontWeight="Bold" CornerRadius="{DynamicResource AppCornerRadius}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

