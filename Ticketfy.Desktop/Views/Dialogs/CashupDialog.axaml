<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels.Dialogs"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:controls="using:Ticketfy.Controls"
             x:Class="Ticketfy.Views.Dialogs.CashupDialog"
             x:DataType="vm:CashupDialogViewModel">

    <Border Width="600" Padding="24" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
        <DockPanel LastChildFill="True">
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="CashMultiple" Width="22" Height="22" Foreground="{DynamicResource AccentPrimaryBrush}" />
                        <TextBlock Text="Arqueo y Cierre Físico de Caja" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding CancelCommand}" Background="Transparent" BorderThickness="0" Padding="4">
                        <mi:MaterialIcon Kind="Close" Width="20" Height="20" Foreground="{DynamicResource TextMutedBrush}" />
                    </Button>
                </Grid>
                <TextBlock Text="Ingrese el conteo de billetes y monedas en cajón para calcular el arqueo de caja del turno." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <!-- Bottom Action Buttons -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" Spacing="10">
                <controls:AlertBannerControl Message="{Binding FeedbackMessage}" IsError="{Binding IsFeedbackError}" />

                <Grid ColumnDefinitions="*,*">
                    <Button Grid.Column="0" Command="{Binding CancelCommand}" Content="Cancelar" Margin="0,0,6,0" Padding="12"
                            Background="{DynamicResource BgPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Foreground="{DynamicResource TextPrimaryBrush}" CornerRadius="6" HorizontalContentAlignment="Center" />

                    <Button Grid.Column="1" Command="{Binding SaveCashupCommand}" Content="GUARDAR ARQUEO Y CORTE" Margin="6,0,0,0" Padding="12"
                            Classes="success-action" FontWeight="Bold" CornerRadius="6" HorizontalContentAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- Middle Denominations Matrix -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <!-- 1. Top 4 Category Cards (Fondo Inicial, Ingresos, Egresos, Diferencia) -->
                    <UniformGrid Columns="4">
                        <!-- 1. FONDO INICIAL -->
                        <Border Margin="0,0,3,0" Padding="10" Background="{DynamicResource BgPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <StackPanel Spacing="2">
                                <TextBlock Text="1. Fondo Inicial" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding OpenCashAmount, StringFormat='${0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- 2. INGRESOS -->
                        <Border Margin="3,0" Padding="10" Background="{DynamicResource BgPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <StackPanel Spacing="2">
                                <TextBlock Text="2. Ingresos" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding TotalIngresosShift, StringFormat='${0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentSuccessBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- 3. EGRESOS -->
                        <Border Margin="3,0" Padding="10" Background="{DynamicResource BgPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <StackPanel Spacing="2">
                                <TextBlock Text="3. Egresos (Gastos)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding TotalEgresosShift, StringFormat='${0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentDangerBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- 4. DIFERENCIA -->
                        <Border Margin="3,0,0,0" Padding="10" Background="{DynamicResource BgPrimaryBrush}" BorderBrush="{Binding DifferenceAmountColor}" BorderThickness="2" CornerRadius="6" IsVisible="{Binding !IsBlindMode}">
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="4. Diferencia" FontSize="11" FontWeight="Bold" Foreground="{Binding DifferenceAmountColor}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DifferenceStatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding DifferenceAmountColor}" />
                                </Grid>
                                <TextBlock Text="{Binding DifferenceAmount, StringFormat='${0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="{Binding DifferenceAmountColor}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- 2. Conteo Físico Total (Ubicar justo debajo de las 4 categorías) -->
                    <Border Background="{DynamicResource BgTertiaryBrush}" Padding="12" CornerRadius="6" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="2">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="CONTEO FÍSICO TOTAL EN CAJÓN" FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="0.5" />
                                <TextBlock Text="Suma calculada en tiempo real según desglose por billetes y monedas" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding TotalPhysicalCash, StringFormat='${0:N2}'}" FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Denomination Grid -->
                    <TextBlock Text="Desglose Físico por Denominación" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />

                    <UniformGrid Columns="2">
                        <!-- Billetes -->
                        <StackPanel Margin="4" Spacing="8">
                            <TextBlock Text="Billetes" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />

                            <Grid ColumnDefinitions="80,*">
                                <TextBlock Text="$1,000" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <controls:NumericTextBox Grid.Column="1" AllowDecimals="False" Text="{Binding Count1000, Mode=TwoWay}" Watermark="0" Padding="6,4" />
                            </Grid>

                            <Grid ColumnDefinitions="80,*">
                                <TextBlock Text="$500" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <controls:NumericTextBox Grid.Column="1" AllowDecimals="False" Text="{Binding Count500, Mode=TwoWay}" Watermark="0" Padding="6,4" />
                            </Grid>

                            <Grid ColumnDefinitions="80,*">
                                <TextBlock Text="$200" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <controls:NumericTextBox Grid.Column="1" AllowDecimals="False" Text="{Binding Count200, Mode=TwoWay}" Watermark="0" Padding="6,4" />
                            </Grid>

                            <Grid ColumnDefinitions="80,*">
                                <TextBlock Text="$100" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <controls:NumericTextBox Grid.Column="1" AllowDecimals="False" Text="{Binding Count100, Mode=TwoWay}" Watermark="0" Padding="6,4" />
                            </Grid>

                            <Grid ColumnDefinitions="80,*">
                                <TextBlock Text="$50" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <controls:NumericTextBox Grid.Column="1" AllowDecimals="False" Text="{Binding Count50, Mode=TwoWay}" Watermark="0" Padding="6,4" />
                            </Grid>

                            <Grid ColumnDefinitions="80,*">
                                <TextBlock Text="$20" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <controls:NumericTextBox Grid.Column="1" AllowDecimals="False" Text="{Binding Count20, Mode=TwoWay}" Watermark="0" Padding="6,4" />
                            </Grid>
                        </StackPanel>

                        <!-- Monedas -->
                        <StackPanel Margin="4" Spacing="8">
                            <TextBlock Text="Monedas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentWarningBrush}" />

                            <Grid ColumnDefinitions="80,*">
                                <TextBlock Text="$10" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <controls:NumericTextBox Grid.Column="1" AllowDecimals="False" Text="{Binding Count10, Mode=TwoWay}" Watermark="0" Padding="6,4" />
                            </Grid>

                            <Grid ColumnDefinitions="80,*">
                                <TextBlock Text="$5" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <controls:NumericTextBox Grid.Column="1" AllowDecimals="False" Text="{Binding Count5, Mode=TwoWay}" Watermark="0" Padding="6,4" />
                            </Grid>

                            <Grid ColumnDefinitions="80,*">
                                <TextBlock Text="$2" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <controls:NumericTextBox Grid.Column="1" AllowDecimals="False" Text="{Binding Count2, Mode=TwoWay}" Watermark="0" Padding="6,4" />
                            </Grid>

                            <Grid ColumnDefinitions="80,*">
                                <TextBlock Text="$1" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <controls:NumericTextBox Grid.Column="1" AllowDecimals="False" Text="{Binding Count1, Mode=TwoWay}" Watermark="0" Padding="6,4" />
                            </Grid>

                            <Grid ColumnDefinitions="80,*">
                                <TextBlock Text="$0.50" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <controls:NumericTextBox Grid.Column="1" AllowDecimals="False" Text="{Binding Count050, Mode=TwoWay}" Watermark="0" Padding="6,4" />
                            </Grid>
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="Notas / Observaciones de Cierre" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding Notes, Mode=TwoWay}" Watermark="Observaciones del corte de caja..." Height="60" AcceptsReturn="True" TextWrapping="Wrap" Padding="8" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>

