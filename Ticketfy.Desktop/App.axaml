<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="Ticketfy.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="AppFontFamily">Inter, Segoe UI, sans-serif</FontFamily>

            <!-- ═══ LEVEL 1: GLOBAL DESIGN SYSTEM TOKENS ═══ -->
            <!-- Base Surfaces -->
            <Color x:Key="SurfaceAppBackground">#F8FAFC</Color>
            <Color x:Key="SurfaceCardBackground">#FFFFFF</Color>
            <Color x:Key="SurfacePanelSubtle">#F1F5F9</Color>

            <!-- Borders & Dividers -->
            <Color x:Key="BorderNeutralSubtle">#E2E8F0</Color>
            <Color x:Key="BorderNeutralStrong">#CBD5E1</Color>

            <!-- Typography & Content -->
            <Color x:Key="TextPrimary">#0F172A</Color>
            <Color x:Key="TextSecondary">#64748B</Color>
            <Color x:Key="TextMuted">#94A3B8</Color>

            <!-- Accent & Status Colors -->
            <Color x:Key="AccentBrandPrimary">#2563EB</Color>
            <Color x:Key="AccentBrandSubtle">#EFF6FF</Color>
            <Color x:Key="StatusSuccess">#10B981</Color>
            <Color x:Key="StatusSuccessSubtle">#ECFDF5</Color>
            <Color x:Key="StatusDanger">#EF4444</Color>
            <Color x:Key="StatusDangerSubtle">#FEF2F2</Color>
            <Color x:Key="StatusWarning">#F59E0B</Color>

            <!-- SolidColorBrushes -->
            <SolidColorBrush x:Key="BgPrimaryBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="BgSecondaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BgTertiaryBrush" Color="#F1F5F9" />
            <SolidColorBrush x:Key="BorderBrush" Color="#CBD5E1" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="AccentBrandSubtleBrush" Color="#EFF6FF" />
            <SolidColorBrush x:Key="AccentSuccessBrush" Color="#10B981" />
            <SolidColorBrush x:Key="AccentDangerBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="AccentWarningBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="SidebarBgBrush" Color="#1E3A8A" />
            <SolidColorBrush x:Key="SidebarNavIconBrush" Color="#93C5FD" />

            <CornerRadius x:Key="AppCornerRadius">6</CornerRadius>
            <x:Double x:Key="AppBaseFontSize">14</x:Double>
            <x:Double x:Key="PosPriceFontSize">24</x:Double>
            <x:Double x:Key="PosCartWidth">380</x:Double>
            <x:Double x:Key="AppLogoHeight">32</x:Double>
            <x:Double x:Key="GlassmorphismBlurRadius">0</x:Double>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme Locale="es-MX" />
        <StyleInclude Source="avares://Semi.Avalonia.DataGrid/Index.axaml" />
        <materialIcons:MaterialIconStyles />
        <StyleInclude Source="avares://Ticketfy.Desktop/Styles/AppTheme.axaml" />

        <!-- ═══ REUSABLE POS BUTTON STYLES ═══ -->
        <Style Selector="Button.PrimaryPOS">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
        </Style>

        <Style Selector="Button.SuccessPOS">
            <Setter Property="Background" Value="{DynamicResource AccentSuccessBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
        </Style>

        <Style Selector="Button.DangerPOS">
            <Setter Property="Background" Value="{DynamicResource AccentDangerBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
        </Style>

        <Style Selector="Button.SecondaryPOS">
            <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
    </Application.Styles>

</Application>
