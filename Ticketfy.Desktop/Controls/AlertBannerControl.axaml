<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="Ticketfy.Controls.AlertBannerControl"
             x:Name="RootBanner"
             IsVisible="{Binding #RootBanner.HasMessage}">

    <Border Padding="12,10" CornerRadius="8"
            Background="{Binding #RootBanner.BannerBackground}"
            BorderBrush="{Binding #RootBanner.BannerBorderBrush}"
            BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <!-- Icon -->
            <mi:MaterialIcon Grid.Column="0"
                            Kind="{Binding #RootBanner.BannerIconKind}"
                            Width="20" Height="20"
                            Foreground="{Binding #RootBanner.BannerForeground}"
                            Margin="0,0,10,0" VerticalAlignment="Center" />

            <!-- Message Text -->
            <TextBlock Grid.Column="1"
                       Text="{Binding #RootBanner.Message}"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{Binding #RootBanner.BannerForeground}"
                       TextWrapping="Wrap" VerticalAlignment="Center" />

            <!-- Close Button -->
            <Button Grid.Column="2"
                    Command="{Binding #RootBanner.Dismiss}"
                    Padding="4" Background="Transparent" BorderThickness="0"
                    Margin="8,0,0,0" VerticalAlignment="Center">
                <mi:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{Binding #RootBanner.BannerForeground}" />
            </Button>
        </Grid>
    </Border>
</UserControl>
