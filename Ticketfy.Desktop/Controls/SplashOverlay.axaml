<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ticketfy.ViewModels"
             x:Class="Ticketfy.Controls.SplashOverlay"
             x:DataType="vm:MainWindowViewModel">

    <!-- ═══ SPLASH SCREEN OVERLAY ═══ -->
    <Grid ZIndex="10000" IsVisible="{Binding IsSplashScreenVisible}" Background="{DynamicResource BgPrimaryBrush}">
        <Grid.Styles>
            <Style Selector="Svg.pulse">
                <Style.Animations>
                    <Animation Duration="0:0:1.5" IterationCount="Infinite" PlaybackDirection="Alternate">
                        <KeyFrame Cue="0%">
                            <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
                            <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                            <Setter Property="ScaleTransform.ScaleX" Value="1.1"/>
                            <Setter Property="ScaleTransform.ScaleY" Value="1.1"/>
                        </KeyFrame>
                    </Animation>
                </Style.Animations>
            </Style>
        </Grid.Styles>
        
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
            <!-- LOGO SVG -->
            <Svg Classes="pulse" Path="/Assets/logo.svg" Width="180" Height="180" HorizontalAlignment="Center"/>
            
            <TextBlock Text="INICIANDO TICKETFY!" FontSize="24" FontWeight="Black" 
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" LetterSpacing="2"/>
            
            <TextBlock Text="Por favor espere, cargando módulos..." FontSize="14" 
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                       
            <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,16,0,0" Foreground="{DynamicResource AccentBrandBrush}" Background="#1E293B"/>
        </StackPanel>
    </Grid>
</UserControl>
